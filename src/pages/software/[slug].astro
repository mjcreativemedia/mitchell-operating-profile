---
import BaseLayout from "../../layouts/BaseLayout.astro"; import MediaSlot from "../../components/MediaSlot.astro"; import { projects, slugify, type Project } from "../../lib/projects";
export function getStaticPaths(){return projects.map((project)=>({params:{slug:slugify(project.name)},props:{project}}))}
interface Props{project:Project} const {project}=Astro.props;
---
<BaseLayout title={`${project.name} — Mitchell Argamasilla`} description={project.description}><section class="project-hero"><div><p class="eyebrow">{project.category} · {project.status}</p><h1>{project.name}</h1><p>{project.description}</p><div class="project-actions">{project.demo&&<a class="button dark" href={project.demo} target="_blank">Live demo ↗</a>}{project.github&&<a class="button" href={project.github} target="_blank">GitHub ↗</a>}</div></div><MediaSlot label={`${project.name} hero screenshot`} src={project.image} ratio="square" note="Add strongest product screen" /></section>
<section class="content-section project-story"><div><p class="eyebrow">Problem</p><h2>Add the exact problem this project started with.</h2><p>The current summary establishes the product. This slot is ready for the real context, user, constraint, and reason it needed to exist.</p></div><div><p class="eyebrow">Solution</p><h2>{project.description}</h2><div class="tag-list">{project.tags.map((tag)=><span>{tag}</span>)}</div></div></section>
<section class="content-section dark-section"><div class="section-head"><h2>Product evidence</h2><p>Drop screenshots into these slots when you select them from the project or phone.</p></div><div class="visual-grid"><MediaSlot label="Primary workflow" /><MediaSlot label="Detail or result" /><MediaSlot label="Mobile or alternate view" /></div></section>
<section class="content-section"><div class="section-head"><h2>Lessons learned</h2><p>Add the design decision, technical constraint, field observation, or workflow lesson that changed how you build.</p></div><a class="button" href="/software/">← Back to apps & tools</a></section></BaseLayout>
<style>.project-hero{padding:clamp(70px,9vw,130px) 4vw;display:grid;grid-template-columns:1.2fr .8fr;gap:7vw;align-items:center}.project-hero h1{font-size:clamp(4rem,9vw,9rem);line-height:.8;letter-spacing:-.085em;margin:0}.project-hero>div>p:not(.eyebrow){max-width:680px;color:var(--muted);font-size:1.2rem;line-height:1.55;margin:34px 0}.project-actions{display:flex;gap:10px;flex-wrap:wrap}.project-story{display:grid;grid-template-columns:1fr 1fr;gap:9vw;border-top:1px solid var(--ink)}.project-story h2{font-size:clamp(2rem,4vw,4rem);line-height:.95;letter-spacing:-.06em}.project-story p{color:var(--muted);line-height:1.6}@media(max-width:750px){.project-hero,.project-story{grid-template-columns:1fr}.project-hero{padding-left:20px;padding-right:20px}}</style>
