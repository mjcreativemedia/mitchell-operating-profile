---
import BaseLayout from "../../layouts/BaseLayout.astro"; import PageHero from "../../components/PageHero.astro"; import MediaSlot from "../../components/MediaSlot.astro"; import { projects, projectCount, slugify } from "../../lib/projects";
const featured = projects.filter((p)=>p.featured); const rest = projects.filter((p)=>!p.featured);
---
<BaseLayout title={`Software — ${projectCount} Projects by Mitchell Argamasilla`}><PageHero eyebrow={`${projectCount} indexed projects`} title="Software product catalog." intro="Native apps, websites, search systems, automation, and practical utilities. Open a project for its problem, solution, technology, links, and media slots." />
<section class="content-section"><div class="section-head"><h2>Featured builds</h2><p>Selected for usefulness, range, and the clarity of the problem they solve.</p></div><div class="software-grid">{featured.map((project)=><a class="software-card" href={`/software/${slugify(project.name)}/`}><MediaSlot label={`${project.name} screenshots`} src={project.image}/><div><h3>{project.name}</h3><p>{project.description}</p><div class="tag-list">{project.tags.slice(0,4).map((tag)=><span>{tag}</span>)}</div></div></a>)}</div></section>
<section class="content-section dark-section"><div class="section-head"><h2>Search the archive</h2><p>Search by project, technology, industry, or problem.</p></div><label class="project-search"><span>⌕</span><input type="search" id="project-search" placeholder="Try delivery, Bible, Swift, automation…" aria-label="Search projects" /><small id="project-count">{rest.length} projects</small></label><div class="archive-list" id="archive-list">{rest.map((project)=><a href={`/software/${slugify(project.name)}/`} data-search={[project.name,project.description,...project.tags].join(" ").toLowerCase()}><strong>{project.name}</strong><span>{project.category}</span><small>{project.tags.slice(0,3).join(" · ")}</small></a>)}</div></section>
<script>const input=document.querySelector<HTMLInputElement>("#project-search");const rows=[...document.querySelectorAll<HTMLElement>("#archive-list a")];const count=document.querySelector("#project-count");input?.addEventListener("input",()=>{const q=input.value.trim().toLowerCase();let shown=0;rows.forEach(row=>{const visible=!q||row.dataset.search?.includes(q);row.hidden=!visible;if(visible)shown++});if(count)count.textContent=`${shown} projects`})</script></BaseLayout>
<style>.software-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.software-card{border:1px solid var(--ink);background:#fff}.software-card>.media-slot{border:0;border-bottom:1px solid var(--ink)}.software-card>div:last-child{padding:24px}.software-card h3{font-size:2.2rem;letter-spacing:-.055em;margin:0 0 12px}.software-card p{color:var(--muted);line-height:1.5}.project-search{height:78px;border:1px solid #555;display:flex;align-items:center;gap:18px;padding:0 22px}.project-search span{color:var(--acid);font-size:2rem}.project-search input{width:100%;border:0;background:transparent;color:#fff;outline:0;font-size:1.25rem}.project-search small{color:#888;white-space:nowrap;font:700 .62rem/1 monospace;text-transform:uppercase}.archive-list{margin-top:30px}.archive-list a{display:grid;grid-template-columns:1.5fr .5fr .8fr;gap:20px;padding:20px 0;border-top:1px solid #383836;align-items:center}.archive-list strong{font-size:1.35rem}.archive-list span,.archive-list small{color:#888;font:700 .63rem/1.4 monospace;text-transform:uppercase}.archive-list a:hover strong{color:var(--acid)}@media(max-width:700px){.software-grid{grid-template-columns:1fr}.archive-list a{grid-template-columns:1fr}.project-search small{display:none}}</style>
