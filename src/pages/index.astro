---
import BaseLayout from "../layouts/BaseLayout.astro";

const experience = [
  {
    role: "Automan Auto Sales",
    detail: "Small dealership · Norcross, GA · 2022–2023",
    bullets: [
      "Moved vehicles between locations",
      "Maintained oil, fluids, and basic condition",
      "Coordinated with repair shops for service",
      "Washed, detailed, and listed vehicles for sale",
    ],
  },
  {
    role: "DoorDash",
    detail: "Food delivery · Chicago, IL · 2025–2026",
    bullets: [
      "Gold-level Dasher with a 5-star customer rating",
      "Completed bicycle deliveries independently and consistently",
    ],
  },
  {
    role: "Software Developer",
    detail: "Freelance · Chicago, IL · 2019–current",
    bullets: [
      "Built websites and web applications for businesses",
      "Built lead capture, database, and payment systems",
    ],
  },
];

const skills = ["Hands-on work", "Maintenance", "Tools", "Measuring", "Problem solving", "Teamwork", "Reliable", "Willing to learn"];
---

<BaseLayout title="Mitchell Argamasilla — Entry-Level Trades Candidate" description="Resume for Mitchell Argamasilla, an entry-level trades candidate in Chicago.">
  <section class="resume" aria-labelledby="name">
    <header class="intro">
      <img src="/profile.jpeg" alt="Mitchell Argamasilla" />
      <div>
        <p class="kicker">Entry-level trades candidate</p>
        <h1 id="name">Mitchell Argamasilla</h1>
      </div>
    </header>

    <div class="contact" aria-label="Contact details">
      <span>Chicago, IL</span><span>773-236-6224</span><a href="mailto:mjcreativemedia1@gmail.com">mjcreativemedia1@gmail.com</a><span>Reliable transportation</span>
    </div>

    <section class="summary" aria-labelledby="summary-title">
      <h2 id="summary-title">Seeking construction, masonry, or pre-apprenticeship opportunity.</h2>
      <p>Reliable, physically active, and willing to learn hands-on trade skills.</p>
    </section>

    <section class="experience" aria-labelledby="experience-title">
      <p class="label" id="experience-title">Experience</p>
      {experience.map((job) => (
        <article class="job">
          <div class="job-heading"><h3>{job.role}</h3><p>{job.detail}</p></div>
          <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
        </article>
      ))}
    </section>

    <section class="skills" aria-labelledby="skills-title">
      <p class="label" id="skills-title">Skills</p>
      <div>{skills.map((skill) => <span>{skill}</span>)}</div>
    </section>
  </section>
</BaseLayout>

<style>
  .resume { width:min(100% - 40px, 850px); margin:0 auto; padding:clamp(64px, 10vw, 120px) 0 80px; }
  .intro { display:flex; align-items:flex-start; gap:24px; border-bottom:1px solid var(--line); padding-bottom:34px; }
  .intro img { width:82px; height:82px; margin-top:34px; border-radius:50%; object-fit:cover; filter:grayscale(1); }
  .kicker,.label { margin:0 0 12px; color:var(--muted); font:700 .7rem/1.2 monospace; letter-spacing:.1em; text-transform:uppercase; }
  h1 { margin:0; font-size:clamp(2.7rem, 6.4vw, 5.25rem); line-height:.9; letter-spacing:-.08em; }
  .contact { display:flex; flex-wrap:wrap; gap:8px 0; padding:18px 0; border-bottom:1px solid var(--line); color:var(--muted); font-size:.88rem; }
  .contact>* { padding:0 12px; border-right:1px solid var(--line); }.contact>*:first-child { padding-left:0; }.contact>*:last-child { border:0; }
  .contact a:hover { color:var(--ink); text-decoration:underline; }
  .summary { padding:clamp(54px, 8vw, 80px) 0; border-bottom:1px solid var(--line); }.summary h2 { max-width:620px; margin:0; font-size:clamp(1.8rem, 3.7vw, 3.25rem); line-height:1; letter-spacing:-.055em; }.summary p { max-width:610px; margin:22px 0 0; color:var(--muted); font-size:1.1rem; line-height:1.55; }
  .experience,.skills { padding-top:54px; }.job { display:grid; grid-template-columns:minmax(190px, .78fr) 1.22fr; gap:36px; padding:28px 0; border-top:1px solid var(--line); }.job h3 { margin:0; font-size:1.35rem; letter-spacing:-.04em; }.job-heading p { margin:5px 0 0; color:var(--muted); font-size:.88rem; line-height:1.4; }.job ul { margin:0; padding-left:18px; line-height:1.6; }.job li+li { margin-top:5px; }
  .skills { padding-bottom:20px; }.skills>div { display:flex; flex-wrap:wrap; gap:9px; }.skills span { border:1px solid var(--line); border-radius:99px; padding:8px 11px; font-size:.84rem; }
  @media (max-width:600px) { .resume { width:min(100% - 32px, 850px); padding-top:52px; }.intro { align-items:flex-start; gap:17px; }.intro img { width:57px; height:57px; margin-top:28px; }.contact { font-size:.8rem; }.contact>* { padding:0 8px; }.job { grid-template-columns:1fr; gap:15px; }.job ul { padding-left:20px; } }
</style>
