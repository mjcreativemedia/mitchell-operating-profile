---
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaSlot from "../components/MediaSlot.astro";
import site from "../../content/site.json";
import { appProjects, appProjectCount } from "../lib/projects";
const featured = appProjects.filter((project) => project.featured).slice(0, 4);
---
<BaseLayout>
  <section class="home-hero">
    <div class="home-copy">
      <p class="eyebrow">{site.location} · Operating profile</p><h1>{site.name}</h1><h2>{site.headline}</h2><p>{site.intro}</p>
      <div class="hero-actions"><a class="button dark" href="/software/">Explore the work →</a><a class="button" href="/contact/">Contact Mitchell ↗</a></div>
    </div>
    <div class="hero-photo"><img src="/profile.jpeg" alt="Mitchell Argamasilla wearing a white hoodie" /><span>Developer · Systems builder · Bike courier</span></div>
  </section>

  <section class="home-services">
    <div class="home-section-title"><p class="eyebrow">Choose a door</p><h2>What can I help you with?</h2></div>
    <div class="service-grid">{site.services.map((service, index) => <a class={`service-card ${service.accent}`} href={service.href}><span>0{index + 1}</span><h3>{service.title}</h3><p>{service.description}</p><strong>Explore →</strong></a>)}</div>
  </section>

  <section class="home-projects">
    <div class="home-section-title"><p class="eyebrow">Featured apps & tools</p><h2>Four projects. Four real problems.</h2><a href="/software/">View all {appProjectCount} builds →</a></div>
    <div class="project-showcase">{featured.map((project) => <a href={`/software/${project.name.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"")}/`} class="showcase-card"><MediaSlot label={`${project.name} screenshot`} src={project.image} note="Replace or add more screens" /><div><h3>{project.name}</h3><div class="tag-list">{project.tags.slice(0,3).map((tag) => <span>{tag}</span>)}</div></div></a>)}</div>
  </section>

  <section class="highlights">
    <div class="home-section-title"><p class="eyebrow">Recent work & evidence</p><h2>A visual record, ready for your phone library.</h2></div>
    <div class="visual-grid">
      <a class="wide" href="/operations/"><MediaSlot label="3L Living maintenance photos" note="Trash rooms · completed work · documentation app" /></a>
      <a href="/fitness/"><MediaSlot label="Boxing training" src="/media/boxing-poster.jpg" ratio="portrait" /></a>
      <a href="/fitness/"><MediaSlot label="Chicago cycling" src="/performance-cycling.jpg" ratio="portrait" /></a>
      <a class="wide" href="/about/"><MediaSlot label="Working on the MacBook" src="/media/building-ekom.jpg" /></a>
    </div>
  </section>

  <section class="quick-stats">
    <div><strong>{appProjectCount}</strong><span>apps & tools indexed</span></div><div><strong>2017</strong><span>started programming</span></div><div><strong>Chicago</strong><span>operating base</span></div><div><strong>Purdue</strong><span>university foundation</span></div>
  </section>

  <section class="home-contact"><p class="eyebrow">The short version</p><h2>I build things, solve problems, and follow through.</h2><a class="button dark" href="/contact/">Start a conversation ↗</a></section>
</BaseLayout>

<style>
.home-hero { min-height:calc(100vh - 74px); display:grid; grid-template-columns:1.25fr .75fr; gap:7vw; padding:clamp(55px,7vw,100px) 4vw; align-items:center; }.home-copy h1 { margin:0; font-size:clamp(4.6rem,10vw,10rem); line-height:.76; letter-spacing:-.09em; }.home-copy h2 { margin:38px 0 16px; max-width:850px; font-size:clamp(1.8rem,3.3vw,3.5rem); line-height:1; letter-spacing:-.055em; }.home-copy>p:last-of-type { max-width:670px; color:var(--muted); font-size:1.1rem; line-height:1.55; }.hero-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:30px; }.hero-photo { aspect-ratio:4/5; border:1px solid var(--ink); position:relative; overflow:hidden; background:var(--blue); box-shadow:16px 16px 0 var(--acid); }.hero-photo img { width:100%; height:100%; object-fit:cover; filter:grayscale(1) contrast(1.12); }.hero-photo span { position:absolute; left:14px; right:14px; bottom:14px; padding:11px; background:var(--paper); border:1px solid var(--ink); font:700 .6rem/1.3 monospace; text-transform:uppercase; }
.home-services,.home-projects,.highlights { padding:clamp(70px,9vw,130px) 4vw; }.home-services { background:var(--orange); }.home-section-title { display:grid; grid-template-columns:.55fr 1.25fr .35fr; gap:5vw; align-items:end; margin-bottom:48px; }.home-section-title h2 { margin:0; font-size:clamp(3rem,6vw,6rem); line-height:.88; letter-spacing:-.07em; }.home-section-title>a { font:800 .65rem/1.4 monospace; text-transform:uppercase; border-bottom:1px solid; justify-self:end; }.service-grid { display:grid; grid-template-columns:repeat(4,1fr); border:1px solid var(--ink); }.service-card { min-height:280px; padding:24px; display:flex; flex-direction:column; border-right:1px solid var(--ink); }.service-card:last-child { border:0; }.service-card span,.service-card strong { font:800 .63rem/1 monospace; text-transform:uppercase; }.service-card h3 { margin:68px 0 12px; font-size:2rem; letter-spacing:-.055em; }.service-card p { margin:0; color:#3f3e3a; line-height:1.45; }.service-card strong { margin-top:auto; }.service-card:hover { background:var(--paper); }
.home-projects { background:var(--paper); }.project-showcase { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; }.showcase-card { border:1px solid var(--ink); background:#fff; }.showcase-card>div:last-child { padding:20px; display:flex; align-items:center; justify-content:space-between; gap:20px; }.showcase-card h3 { margin:0; font-size:1.8rem; letter-spacing:-.05em; }.showcase-card .media-slot { border:0; border-bottom:1px solid var(--ink); }.showcase-card:hover .media-slot img { transform:scale(1.02); }.showcase-card img { transition:.3s; }
.highlights { background:#d8d7d0; }.quick-stats { display:grid; grid-template-columns:repeat(4,1fr); background:var(--ink); color:#fff; }.quick-stats div { min-height:145px; padding:28px 3vw; display:flex; flex-direction:column; justify-content:center; border-right:1px solid #363633; }.quick-stats strong { color:var(--acid); font-size:clamp(2rem,3.5vw,3.8rem); letter-spacing:-.06em; }.quick-stats span { color:#999; font:700 .62rem/1.4 monospace; text-transform:uppercase; }.home-contact { padding:clamp(80px,10vw,150px) 4vw; background:var(--acid); display:grid; grid-template-columns:.5fr 1.4fr .4fr; gap:5vw; align-items:end; }.home-contact h2 { margin:0; font-size:clamp(3rem,6vw,6.6rem); line-height:.88; letter-spacing:-.075em; }
@media(max-width:900px){.home-hero{grid-template-columns:1fr}.hero-photo{max-width:450px}.home-section-title{grid-template-columns:1fr}.home-section-title>a{justify-self:start}.service-grid{grid-template-columns:repeat(2,1fr)}.service-card{border-bottom:1px solid var(--ink)}.home-contact{grid-template-columns:1fr}.quick-stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.home-hero,.home-services,.home-projects,.highlights,.home-contact{padding-left:20px;padding-right:20px}.home-copy h1{font-size:21vw}.service-grid,.project-showcase{grid-template-columns:1fr}.service-card{border-right:0}.showcase-card>div:last-child{display:block}.showcase-card .tag-list{margin-top:14px}.quick-stats div{padding:22px 20px}.home-contact .button{justify-self:start}}
</style>
