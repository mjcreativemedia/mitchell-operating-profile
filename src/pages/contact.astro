---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import MediaSlot from "../components/MediaSlot.astro"; import site from "../../content/site.json";
---
<BaseLayout title="Contact Mitchell Argamasilla"><PageHero eyebrow="Contact" title="Bring me a real problem." intro="Available for software development, websites, IT support, maintenance, operations, and practical consulting in Chicago or remotely." />
<section class="content-section"><div class="contact-grid"><a href={`mailto:${site.email}`}><span>Email</span><strong>{site.email}</strong><small>Best direct contact ↗</small></a><a href={site.github} target="_blank"><span>GitHub</span><strong>mjcreativemedia</strong><small>Source and repositories ↗</small></a><div><span>Résumé</span><strong>PDF slot</strong><small>Add verified résumé</small></div><div><span>Tap card</span><strong>NFC-ready URL</strong><small>Use the permanent personal domain</small></div></div></section>
<section class="content-section dark-section"><div class="section-head"><h2>What to send</h2><p>A short description of the problem, what success looks like, location if physical work is involved, and any deadline.</p></div><MediaSlot label="60-second introduction video" note="Optional personal welcome for tap-card visitors" /></section></BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--ink);border-left:1px solid var(--ink)}.contact-grid>*{min-height:260px;padding:28px;border-right:1px solid var(--ink);border-bottom:1px solid var(--ink);display:flex;flex-direction:column}.contact-grid span,.contact-grid small{font:800 .63rem/1.3 monospace;text-transform:uppercase}.contact-grid span{color:var(--orange)}.contact-grid strong{margin:auto 0;font-size:clamp(1.5rem,3vw,3rem);letter-spacing:-.055em;word-break:break-word}.contact-grid small{color:var(--muted)}.contact-grid a:hover{background:var(--acid)}@media(max-width:650px){.contact-grid{grid-template-columns:1fr}}</style>
