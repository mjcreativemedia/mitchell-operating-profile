---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import MediaSlot from "../components/MediaSlot.astro"; import clients from "../../content/clients.json";
---
<BaseLayout title="Client Work — Mitchell Argamasilla"><PageHero eyebrow={`${clients.length} client records`} title="Work built for other people." intro="Websites and systems for businesses with real customers, schedules, media, and service areas. Each case is ready for before-and-after images and testimonials." />
<section class="content-section"><div class="client-catalog">{clients.map((client,index)=><article><MediaSlot label={`${client.name} before / after`} src={client.image} note="Add website screen or client work photo"/><div><span>{String(index+1).padStart(2,"0")}</span><h2>{client.name}</h2><p>{client.type}</p><div class="client-actions">{client.url&&<a class="button dark" href={client.url} target="_blank" rel="noreferrer">View live site ↗</a>}<small>Testimonial needed</small></div></div></article>)}</div></section>
<section class="content-section dark-section"><div class="section-head"><h2>What every case study needs</h2><p>Before, after, the business problem, your contribution, live result, and one short client quote.</p></div><div class="visual-grid"><MediaSlot label="Client meeting or site visit"/><MediaSlot label="Before / after comparison"/><MediaSlot label="Client testimonial video"/></div></section></BaseLayout>
<style>.client-catalog{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.client-catalog article{border:1px solid var(--ink);background:#fff}.client-catalog article>.media-slot{border:0;border-bottom:1px solid var(--ink)}.client-catalog article>div:last-child{padding:24px}.client-catalog span{color:var(--orange);font:800 .65rem/1 monospace}.client-catalog h2{font-size:2.4rem;letter-spacing:-.06em;margin:28px 0 8px}.client-catalog p{color:var(--muted)}.client-actions{display:flex;align-items:center;gap:10px;margin-top:30px;flex-wrap:wrap}.client-actions small{border:1px dashed var(--ink);padding:8px;font:700 .58rem/1 monospace;text-transform:uppercase}@media(max-width:700px){.client-catalog{grid-template-columns:1fr}}</style>
