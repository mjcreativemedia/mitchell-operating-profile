---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import MediaSlot from "../components/MediaSlot.astro"; import fitness from "../../content/fitness.json";
---
<BaseLayout title="Fitness & Performance — Mitchell Argamasilla"><PageHero eyebrow="Fitness & performance" title="Train for capability, not decoration." intro={fitness.statement} />
<section class="content-section"><div class="fitness-lead"><MediaSlot label="Boxing hero photo" note="Strong training, pads, bag, or sparring image"/><div><p class="eyebrow">Training disciplines</p>{fitness.disciplines.map((discipline,index)=><div class="discipline"><span>0{index+1}</span><h2>{discipline}</h2></div>)}</div></div></section>
<section class="content-section dark-section"><div class="section-head"><h2>Training evidence</h2><p>A few good frames will say more than a gallery of gym selfies.</p></div><div class="visual-grid"><MediaSlot label="Boxing — movement" ratio="portrait"/><MediaSlot label="Strength training" ratio="portrait"/><MediaSlot label="Cycling through Chicago" src="/performance-cycling.jpg" ratio="portrait"/></div></section>
<section class="content-section"><div class="section-head"><h2>Performance profile</h2><p>Stats stay labeled as placeholders until you confirm them.</p></div><div class="performance-grid"><div class="proof-list">{fitness.evidence.map((item)=><span>{item}</span>)}</div><div class="stat-list">{fitness.stats.map((stat)=><div><span>{stat.label}</span><strong>{stat.value}</strong></div>)}</div><MediaSlot label="Short boxing or cycling clip" note="One 20–60 second video"/></div></section></BaseLayout>
<style>.fitness-lead{display:grid;grid-template-columns:1.2fr .8fr;gap:7vw;align-items:center}.discipline{display:flex;align-items:center;gap:25px;border-top:1px solid var(--ink);padding:24px 0}.discipline span{color:var(--orange);font:800 .65rem/1 monospace}.discipline h2{font-size:2.5rem;letter-spacing:-.055em;margin:0}.performance-grid{display:grid;grid-template-columns:.6fr .7fr 1fr;gap:20px}.proof-list{background:var(--orange);padding:25px}.proof-list span{display:block;border-top:1px solid var(--ink);padding:15px 0;font-weight:800}.stat-list{border:1px solid var(--ink)}.stat-list div{padding:20px;border-bottom:1px solid var(--ink)}.stat-list span,.stat-list strong{display:block}.stat-list span{font:700 .62rem/1.3 monospace;text-transform:uppercase}.stat-list strong{margin-top:20px;color:var(--muted)}@media(max-width:760px){.fitness-lead,.performance-grid{grid-template-columns:1fr}}</style>
