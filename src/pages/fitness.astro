---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import VideoCard from "../components/VideoCard.astro"; import fitness from "../../content/fitness.json";
---
<BaseLayout title="Fitness & Performance — Mitchell Argamasilla"><PageHero eyebrow="Fitness & performance" title="Train for capability, not decoration." intro={fitness.statement} />
<section class="content-section"><div class="fitness-lead"><VideoCard src="/media/boxing.mp4" poster="/media/boxing-poster.jpg" title="Boxing" caption="Heavy-bag training and sustained work capacity."/><div><p class="eyebrow">Training disciplines</p>{fitness.disciplines.map((discipline,index)=><div class="discipline"><span>0{index+1}</span><h2>{discipline}</h2></div>)}</div></div></section>
<section class="content-section dark-section"><div class="section-head"><h2>Training evidence</h2><p>Movement, strength, and coaching shown in real sessions.</p></div><div class="training-grid"><VideoCard src="/media/outdoor-muscleup.mp4" poster="/media/outdoor-muscleup-poster.jpg" title="Outdoor muscle-up" caption="Calisthenics practice in Chicago."/><VideoCard src="/media/gym-muscleups.mp4" poster="/media/gym-muscleups-poster.jpg" title="Gym muscle-ups" caption="Repeated skill work under fatigue."/><VideoCard src="/media/calisthenics.mp4" poster="/media/calisthenics-poster.jpg" title="Outdoor calisthenics" caption="Pulling strength and body control."/></div></section>
<section class="content-section"><div class="section-head"><h2>Performance profile</h2><p>Fitness also includes teaching, observation, and adapting a session to the person in front of me.</p></div><div class="performance-grid"><div class="proof-list">{fitness.evidence.map((item)=><span>{item}</span>)}</div><VideoCard src="/media/client-training.mp4" poster="/media/client-training-poster.jpg" title="Client training" caption="Explaining a movement and coaching through an outdoor session."/></div></section></BaseLayout>
<style>.fitness-lead{display:grid;grid-template-columns:1.2fr .8fr;gap:7vw;align-items:center}.fitness-lead :global(video){aspect-ratio:16/10}.discipline{display:flex;align-items:center;gap:25px;border-top:1px solid var(--ink);padding:24px 0}.discipline span{color:var(--orange);font:800 .65rem/1 monospace}.discipline h2{font-size:2.5rem;letter-spacing:-.055em;margin:0}.training-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.performance-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:20px}.performance-grid :global(video){aspect-ratio:16/9}.proof-list{background:var(--orange);padding:25px}.proof-list span{display:block;border-top:1px solid var(--ink);padding:15px 0;font-weight:800}@media(max-width:760px){.fitness-lead,.performance-grid,.training-grid{grid-template-columns:1fr}}</style>
