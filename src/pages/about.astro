---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import MediaSlot from "../components/MediaSlot.astro";
const timeline = [["2017","Started programming"],["Purdue","Built an academic foundation"],["Clients","Shipped work for real businesses"],["Products","Moved from pages to tools and systems"],["Now","Building software and working in Chicago"]];
---
<BaseLayout title="About Mitchell Argamasilla"><PageHero eyebrow="About" title="How I think and work." intro="I learn difficult systems, reduce the problem to something workable, and keep moving until another person can use the result." />
<section class="content-section"><div class="section-head"><h2>More workshop than résumé.</h2><p>The proof is in shipped software, maintained spaces, completed routes, repaired equipment, and clear client handoffs.</p></div><div class="visual-grid"><MediaSlot label="Working on MacBook" note="Desk or build-session photo" ratio="portrait" /><MediaSlot label="Whiteboard or sketch" note="System planning or project notes" ratio="portrait" /><MediaSlot label="Hands-on repair" note="Computer, bike, or maintenance work" ratio="portrait" /></div></section>
<section class="content-section dark-section"><div class="section-head"><h2>Timeline</h2><p>Milestones, not every line of employment history.</p></div><div class="timeline">{timeline.map(([year,label])=><div><strong>{year}</strong><span>{label}</span></div>)}</div></section>
<section class="content-section"><div class="section-head"><h2>Operating principles</h2></div><div class="card-grid">{[["Build the useful version","Start with what solves the actual problem."],["Learn in real conditions","Test ideas against physical and operational constraints."],["Own the handoff","A result is finished when someone else can use it."],["Stay capable","Technical skill and physical readiness reinforce each other."]].map(([title,copy])=><article class="info-card"><h3>{title}</h3><p>{copy}</p></article>)}</div></section></BaseLayout>
<style>.timeline{max-width:1050px;margin:auto}.timeline div{display:grid;grid-template-columns:180px 1fr;gap:30px;border-top:1px solid #444;padding:28px 0}.timeline strong{color:var(--acid);font:800 .75rem/1 monospace;text-transform:uppercase}.timeline span{font-size:1.7rem;font-weight:800;letter-spacing:-.04em}</style>
