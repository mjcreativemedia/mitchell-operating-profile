---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import MediaSlot from "../components/MediaSlot.astro"; import media from "../../content/media.json";
---
<BaseLayout title="Media — Mitchell Argamasilla"><PageHero eyebrow="Media" title="Watch the work happen." intro="A home for short introductions, lessons, field notes, builds, livestreams, and presentations. The structure is ready before the files are." />
<section class="content-section"><div class="media-catalog">{media.map((item,index)=><article><MediaSlot label={item.title} note={item.status}/><div><span>0{index+1} · {item.type}</span><h2>{item.title}</h2><p>{item.status}</p></div></article>)}</div></section>
<section class="content-section dark-section"><div class="section-head"><h2>Best first upload</h2><p>A direct 60-second phone video: who you are, what you build, the work you want, and how to contact you.</p></div><div class="video-script"><span>01</span><p>“I’m Mitchell Argamasilla. I build software and practical systems in Chicago…”</p><span>02</span><p>Show three fast cuts: software, hands-on work, and cycling or boxing.</p><span>03</span><p>Finish with the kind of problems you can help solve.</p></div></section></BaseLayout>
<style>.media-catalog{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.media-catalog article{border:1px solid var(--ink);background:#fff}.media-catalog article>.media-slot{border:0;border-bottom:1px solid var(--ink)}.media-catalog article>div:last-child{padding:23px}.media-catalog span{font:800 .62rem/1 monospace;text-transform:uppercase;color:var(--orange)}.media-catalog h2{font-size:2rem;letter-spacing:-.05em;margin:28px 0 8px}.media-catalog p{color:var(--muted)}.video-script{max-width:900px;margin:auto}.video-script span{color:var(--acid);font:800 .65rem/1 monospace}.video-script p{font-size:1.5rem;line-height:1.4;border-top:1px solid #444;padding:18px 0 35px}@media(max-width:650px){.media-catalog{grid-template-columns:1fr}}</style>
