---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import MediaSlot from "../components/MediaSlot.astro"; import VideoCard from "../components/VideoCard.astro";
const fieldNotes = [
  { title: "Building Ekom", type: "Software", src: "/media/building-ekom.jpg", caption: "An active product build on the MacBook." },
  { title: "Working session", type: "Collaboration", src: "/media/ekom-meeting.jpg", caption: "Building and reviewing Ekom with the team." },
  { title: "Delivery handoff", type: "Operations", src: "/media/delivery-handoff.jpg", caption: "The physical work behind delivery software and route analysis." },
  { title: "Courier field note", type: "Chicago", src: "/media/courier-portrait.jpg", caption: "Working outside and moving through the city by bike." },
];
---
<BaseLayout title="Media — Mitchell Argamasilla"><PageHero eyebrow="Media" title="Work in progress, on camera." intro="Software sessions, delivery field notes, training, and coaching—real moments behind the finished projects." />
<section class="content-section"><div class="media-catalog">{fieldNotes.map((item,index)=><article><MediaSlot label={item.title} src={item.src}/><div><span>{String(index+1).padStart(2,"0")} · {item.type}</span><h2>{item.title}</h2><p>{item.caption}</p></div></article>)}</div></section>
<section class="content-section dark-section"><div class="section-head"><h2>Movement & coaching</h2><p>Short clips selected from longer phone recordings and compressed for the web.</p></div><div class="video-grid"><VideoCard src="/media/boxing.mp4" poster="/media/boxing-poster.jpg" title="Boxing" caption="Heavy-bag training."/><VideoCard src="/media/client-training.mp4" poster="/media/client-training-poster.jpg" title="Client training" caption="Outdoor movement coaching."/></div></section></BaseLayout>
<style>.media-catalog{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.media-catalog article{border:1px solid var(--ink);background:#fff}.media-catalog article>.media-slot{border:0;border-bottom:1px solid var(--ink)}.media-catalog article>div:last-child{padding:23px}.media-catalog span{font:800 .62rem/1 monospace;text-transform:uppercase;color:var(--orange)}.media-catalog h2{font-size:2rem;letter-spacing:-.05em;margin:28px 0 8px}.media-catalog p{color:var(--muted)}.video-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.video-grid :global(video){aspect-ratio:16/10}@media(max-width:650px){.media-catalog,.video-grid{grid-template-columns:1fr}}</style>
