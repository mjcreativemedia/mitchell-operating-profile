---
import BaseLayout from "../layouts/BaseLayout.astro"; import PageHero from "../components/PageHero.astro"; import MediaSlot from "../components/MediaSlot.astro"; import operations from "../../content/operations.json";
const item=operations.featured;
---
<BaseLayout title="Operations & Maintenance — Mitchell Argamasilla"><PageHero eyebrow="Operations & maintenance" title="Physical work reveals where systems fail." intro="Maintenance, delivery, repair, and documentation are part of the same operating profile. Do the work, notice the friction, and build an improvement." />
<section class="content-section"><article class="ops-case"><div class="ops-mark"><span>3L</span><small>{item.role}</small></div><div><p class="eyebrow">Featured case study</p><h2>{item.name}</h2><div class="ops-columns"><div><strong>Problem</strong><p>{item.problem}</p></div><div><strong>Solution</strong><p>{item.solution}</p></div></div><div class="tag-list">{item.skills.map((skill)=><span>{skill}</span>)}</div></div></article></section>
<section class="content-section dark-section"><div class="section-head"><h2>Maintenance evidence</h2><p>These are the exact photos to pull from your phone when you are back at the computer.</p></div><div class="visual-grid"><MediaSlot label="Trash room — before" note="Wide context photo"/><MediaSlot label="Trash room — after" note="Same angle after completion"/><MediaSlot label="Documentation app" note="Completion record or issue screen"/><MediaSlot label="Cleaning setup" note="Tools, supplies, or in-progress work"/><MediaSlot label="Recurring issue" note="Example with useful context"/><MediaSlot label="Completed work detail" note="Cleanliness and attention to detail"/></div></section>
<section class="content-section"><div class="section-head"><h2>Other operational experience</h2><p>Room for computer repair, network setup, bike repair, general maintenance, and other work records.</p></div><div class="card-grid">{["Computer & IT support","Bike repair & field maintenance","Documentation & process improvement","General repair & troubleshooting"].map((title)=><article class="info-card"><span class="eyebrow">Case study slot</span><h3>{title}</h3><p>Add photos, situation, action, and observable result.</p><strong>Add evidence →</strong></article>)}</div></section></BaseLayout>
<style>.ops-case{display:grid;grid-template-columns:.6fr 1.4fr;border:1px solid var(--ink);background:#fff}.ops-mark{min-height:620px;background:var(--acid);padding:28px;display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--ink)}.ops-mark span{font-size:clamp(8rem,17vw,17rem);font-weight:900;line-height:.6;letter-spacing:-.13em}.ops-mark small{font:800 .66rem/1 monospace;text-transform:uppercase}.ops-case>div:last-child{padding:clamp(32px,5vw,70px)}.ops-case h2{font-size:clamp(3rem,6vw,6rem);line-height:.88;letter-spacing:-.07em;margin:0 0 55px}.ops-columns{display:grid;grid-template-columns:1fr 1fr;gap:40px}.ops-columns strong{font:800 .65rem/1 monospace;text-transform:uppercase;color:var(--orange)}.ops-columns p{line-height:1.6;color:var(--muted)}@media(max-width:760px){.ops-case,.ops-columns{grid-template-columns:1fr}.ops-mark{min-height:330px;border-right:0;border-bottom:1px solid var(--ink)}}</style>
